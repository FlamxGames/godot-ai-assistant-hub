[gd_resource type="Resource" script_class="LLMProviderResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/ai_assistant_hub/llm_providers/llm_provider_resource.gd" id="1_llamacpp"]

[resource]
script = ExtResource("1_llamacpp")
api_id = "llamacpp_api"
name = "llama.cpp (llama-server)"
description = "Run local GGUF models through llama.cpp llama-server. Supports chat, tools, reasoning controls, context usage, Quick Prompts, custom URLs, and optional API keys."
reasoning_levels = Array[String](["Default | Use the model and llama-server defaults", "Disabled | Disable thinking for supported models", "Enabled | Enable thinking using the llama-server default budget", "Low | Limit thinking to approximately 512 tokens", "Medium | Limit thinking to approximately 2048 tokens", "High | Limit thinking to approximately 8192 tokens"])
supports_context_size_override = true
requires_key = true
get_key_url = ""
fix_url = ""
default_url = "http://127.0.0.1:8080"
models_url_postfix = "/v1/models"
chat_url_postfix = "/v1/chat/completions"
max_context_url_postfix = "/props"
capabilities_url_postfix = "/props"
system_role_name = "system"
user_role_name = "user"
assistant_role_name = "assistant"
tool_role_name = "tool"
tool_payload_template = "{
	\"type\": \"function\",
	\"function\": {
		\"name\": \"{<:NAME:>}\",
		\"description\": \"{<:DESC:>}\",
		\"parameters\": {
			\"type\": \"object\",
			\"properties\": {
				{<:PARAM:>}
			},
		\"required\": {<:REQP:>}
		}
	}
}"
tool_param_payload_template = "\"{<:NAME:>}\": {
	\"enum\": {<:ENUM:>},
	\"type\": \"{<:TYPE:>}\",
	\"description\": \"{<:DESC:>}\"
}"
tool_param_type_int = "integer"
tool_param_type_float = "number"
tool_param_type_boolean = "boolean"
tool_param_type_string = "string"
tool_param_type_array = "array"
